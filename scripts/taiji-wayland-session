#!/bin/sh
# Taiji kiosk session for Wayland display managers (SDDM recommended).
set -eu

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Taiji
export GTK_USE_PORTAL=1
export TAIJI_SESSION_MODE=wayland
export TAIJI_BIN="${TAIJI_BIN:-$(command -v taiji 2>/dev/null || echo /usr/bin/taiji)}"

LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/taiji"
mkdir -p "$LOG_DIR"

CONFIG="${TAIJI_SWAY_CONFIG:-/etc/taiji/sway.conf}"
[ -f "$CONFIG" ] || CONFIG="/usr/share/taiji/sway.conf"
if ! command -v sway >/dev/null 2>&1; then
    echo "Taiji Wayland session needs sway. Install it with: sudo apt install sway xwayland" >&2
    sleep 5
    exit 1
fi
if ! command -v Xwayland >/dev/null 2>&1; then
    echo "Taiji Wayland session: xwayland is not installed; X11 apps will not run." >&2
fi

HOTKEYD="${TAIJI_HOTKEYD:-/usr/libexec/taiji/taiji-hotkeyd}"
if [ -x "$HOTKEYD" ]; then
    "$HOTKEYD" >>"$LOG_DIR/hotkeyd.log" 2>&1 &
fi

exec sway -c "$CONFIG" >>"$LOG_DIR/session.log" 2>&1
